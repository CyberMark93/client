# Copia questo file in .env e compila i valori.
# In locale: entrambe obbligatorie. In Docker: arrivano da docker-compose (environment).
# Il file .env reale NON va in Git (lo ignora .gitignore); questo esempio resta tracciato.

# Indirizzo del server LM Studio (API compatibile OpenAI). Default LM Studio:
LM_BASE_URL=http://localhost:1234/v1

# ID del modello, ESATTAMENTE come restituito da GET /v1/models (mai inventato):
LM_MODEL=google/gemma-4-e2b

# Opzionale: fuso orario di ripiego se il modello non lo specifica nella tool-call.
# DEFAULT_TZ=Europe/Rome
